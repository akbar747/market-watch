# .env.example —— market-watch 可配置项的**完整**清单，提交进仓库，绝不提交真实密钥。
#
# 读取方式：pydantic-settings（`application/config.py`，env_prefix = `MW_`）。
# 用法：复制为 `.env` 后按需改值；未出现的字段走代码默认值。
#
# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ ★ 三条不可协商的合规约束（改配置前先读一遍）                                    │
# │                                                                              │
# │ 1. `OFFICIAL_LIMIT`(600 req/min) 与 `HOST_SAFETY_FACTOR`(0.8) 是              │
# │    `domain/policy.py` 里的**代码常量**，不在本文件、不接受环境变量覆盖。         │
# │    有效速率上限 = 600/60 × 0.8 = **8.0 rps**，运行时由 validator 硬钳制。       │
# │ 2. 下面这些旋钮**只能把速率调低，不能调高**；填大于 8.0 的值会被静默钳制         │
# │    并打 `rate.clamped` WARNING。想提速请走第 3 条，不要提 rps。               │
# │ 3. 想提速的**唯一合法路径**：用满 `MW_PAGE_SIZE=200` 减少请求数，                │
# │    或缩小采集范围（`config/sources.yaml` 里关掉不需要的源）。                   │
# │    禁止提高 rps / concurrency——那是对抗限额，不是合规设计。                    │
# └──────────────────────────────────────────────────────────────────────────────┘

# ── 身份（C1：UA 必须自我标识，不可关闭）─────────────────────────────────────
# UA 形如 `market-watch/<version> (+<contact_url>)`。
# contact_url 必须是**真实可联系地址**；`example.invalid` 等占位符会拒绝启动。
MW_CONTACT_URL=https://you.example/contact
# 版本号，会拼进 UA。默认值与 pyproject.toml 的 [project] version 保持一致。
MW_VERSION=0.1.0

# ── 速率与并发（C3：上界 8.0 rps，只能调低）───────────────────────────────────
# 单主机令牌桶生成速率。填 > 8.0 会被钳到 8.0 并打 WARNING。
MW_PER_HOST_RPS=8.0
# 令牌桶突发容量（1~64）。默认 12 ≈ 1.5s 的量，够吸收排头突发与网络抖动。
MW_PER_HOST_BURST=12
# 单主机在飞请求/连接数（1~8）。默认 4。
MW_PER_HOST_CONCURRENCY=4
# 全局在飞任务闸（1~64）。默认 16，防止分页数爆炸时打爆内存。
MW_GLOBAL_INFLIGHT=16

# ── 超时与连接池 ──────────────────────────────────────────────────────────────
MW_CONNECT_TIMEOUT_S=5.0      # 连接建立超时，收紧以便 5s 内暴露 DNS/TLS 卡死
MW_READ_TIMEOUT_S=15.0        # 整页 body 读完的时限（单页约 1.2 MB）
MW_WRITE_TIMEOUT_S=5.0        # GET/HEAD 无 body，形式化设置
MW_POOL_TIMEOUT_S=10.0        # 拿不到连接 = 限流器失配的信号，不要静默等
MW_KEEPALIVE_EXPIRY_S=20.0    # 必须 < 常见 CDN 的 30s 空闲回收
MW_POOL_MAX_CONNECTIONS=20
MW_POOL_MAX_KEEPALIVE=20
MW_HTTP2=false                # 保持 HTTP/1.1 + keep-alive；http2 会让「连接数=并发数」失效

# ── 重试与退避（全抖动，重试同样消耗令牌）──────────────────────────────────────
MW_MAX_ATTEMPTS=4             # 1 次请求 + 3 次重试
MW_BACKOFF_BASE_S=1.0
MW_BACKOFF_FACTOR=2.0
MW_BACKOFF_MAX_S=30.0
MW_RETRY_AFTER_MAX_S=120.0    # Retry-After 的可信上限，超过回落 BACKOFF_MAX_S
MW_TOTAL_ATTEMPT_BUDGET_S=90.0# 单次请求累计（含等待）预算，超预算即停止重试
MW_RETRY_COST=1.0

# ── 熔断（按 host 隔离故障）───────────────────────────────────────────────────
MW_BREAKER_WINDOW_S=60.0
MW_BREAKER_MIN_SAMPLES=20
MW_BREAKER_FAILURE_RATIO=0.5      # 窗口内失败率超过即开闸
MW_BREAKER_CONSECUTIVE_5XX=8      # 连续 8 次 5xx 可直接开闸，不必等比率
MW_BREAKER_OPEN_DURATION_S=60.0
MW_BREAKER_HALF_OPEN_PROBES=3
MW_BREAKER_HALF_OPEN_SUCCESS_TO_CLOSE=3

# ── AIMD 自适应（429/420 时 rate*=0.5，平稳 300s 后 +10% 恢复，上限 = 初始配置值）─
MW_ADAPTIVE_FLOOR_RPS=1.0
MW_ADAPTIVE_HEALTHY_WINDOW_S=300.0
MW_ADAPTIVE_RECOVER_STEP=1.10
# 目标源实测**不返回 X-RateLimit-Remaining 头**，默认关闭；换了新源可打开。
MW_RATELIMIT_HEADER_PROBE=false

# ── 调度周期（会被 Cache-Control: max-age 抬升，配小了也只会被抬到 max-age）──────
MW_PRICES_INTERVAL_S=300        # 全量价格快照；实测 max-age=120
MW_LISTINGS_INTERVAL_S=300      # 观测清单；单品响应 max-age=1200
MW_ITEMS_INTERVAL_S=86400       # 物品元数据，日级刷新
MW_NEWS_INTERVAL_S=900          # 官方公告 RSS，304 不消耗配额
MW_GC_INTERVAL_S=3600           # 保留清理 + rollup + PRAGMA optimize

# ── 采集规模（提速的唯一合法旋钮是 page_size）──────────────────────────────────
MW_PAGE_SIZE=200                # 官方上限 200；用满它 = 少发请求，别提 rps
MW_MAX_PAGES_PER_CYCLE=200      # 分页终止性硬护栏
MW_WATCHLIST_MAX_ITEMS=500
MW_TOPN_HOURLY=2000             # 看板图表降采样点数上限

# ── 存储 ──────────────────────────────────────────────────────────────────────
MW_DB_PATH=src/market_watch/data/market_watch.db
MW_WRITER_QUEUE_SIZE=20000
MW_WRITER_BATCH_SIZE=500
MW_WRITER_MAX_BATCH=2000

# ── 代理（C5：单一静态代理，**禁止代理池 / 逗号列表**）───────────────────────────
# 留空 = 直连。填了也只是这一个静态出口，含逗号（代理池）会拒绝启动。
# 客户端显式 trust_env=False，HTTP(S)_PROXY 环境变量**被忽略**。
MW_PROXY_URL=

# ── 看板（无鉴权，只建议绑 loopback）──────────────────────────────────────────
MW_WEB_HOST=127.0.0.1
MW_WEB_PORT=8000
MW_DOWNSAMPLE_POINTS=2000

# ── 日志 ──────────────────────────────────────────────────────────────────────
MW_LOG_JSON=true                # true = 结构化 JSON（服务向）；脚本排查可设 false
MW_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── 路径 ──────────────────────────────────────────────────────────────────────
MW_CONFIG_DIR=config            # config/sources.yaml + config/alerts.yaml
MW_REJECTS_DIR=data/rejects     # 解析失败样本（不静默丢弃）
MW_PENDING_DIR=data/pending     # 待落库缓冲
